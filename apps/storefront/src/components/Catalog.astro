---
import Layout from "../layouts/Layout.astro";
import { catalog, money, type Product } from "../lib/catalog";
import { catalogParams, DEFAULT_PAGE_SIZE, PAGE_SIZES, pageNumber, pageWindow, searchTerm } from "../../../../src/shared";
type Category = { id: string; slug: string; name: string };
let products: Product[] = [];
let categories: Category[] = [];
let error = "";
let invalid = "";
let total = 0;
const rawQ = Astro.url.searchParams.get("q") ?? "";
const q = searchTerm(rawQ);
const rawCategory = Astro.url.searchParams.get("category") ?? "";
const category = rawCategory && catalogParams.category(rawCategory) ? rawCategory : "";
// An unknown page size or page number falls back to the default rather than failing the whole catalog.
const rawLimit = Number(Astro.url.searchParams.get("limit"));
const pageSize = (PAGE_SIZES as readonly number[]).includes(rawLimit) ? rawLimit : DEFAULT_PAGE_SIZE;
const page = pageNumber(Astro.url.searchParams.get("page") ?? "") ?? 1;
if (q === null) invalid = "Kata kunci pencarian harus 2–60 karakter.";
else if (rawCategory && !category) invalid = "Kategori tidak dikenal.";
try {
  categories = (await catalog(Astro.locals, "/api/categories")).categories;
  if (!invalid) {
    const query = new URLSearchParams();
    if (pageSize !== DEFAULT_PAGE_SIZE) query.set("limit", String(pageSize));
    if (page > 1) query.set("page", String(page));
    if (category) query.set("category", category);
    if (q) query.set("q", q);
    const result = await catalog(Astro.locals, `/api/catalog?${query}`);
    products = result.products;
    total = result.total ?? 0;
  }
} catch {
  error =
    "Katalog sementara tidak tersedia. Silakan muat ulang beberapa saat lagi.";
  Astro.response.status = 503;
}
if (invalid) Astro.response.status = 400;
Astro.response.headers.set(
  "Cache-Control",
  error || invalid ? "no-store" : "public, max-age=0, s-maxage=60",
);
const current = categories.find((c) => c.slug === category);
// Filter links keep the chosen page size but start again at page one.
const link = (next: { category?: string; q?: string | null; page?: number; size?: number }) => {
  const params = new URLSearchParams();
  if (next.category) params.set("category", next.category);
  if (next.q) params.set("q", next.q);
  const size = next.size ?? pageSize;
  if (size !== DEFAULT_PAGE_SIZE) params.set("limit", String(size));
  if (next.page && next.page > 1) params.set("page", String(next.page));
  return `${Astro.url.pathname}${params.size ? `?${params}` : ""}`;
};
const pageLink = (n: number, size = pageSize) => link({ category, q, page: n, size });
const pages = Math.max(1, Math.ceil(total / pageSize));
const firstShown = (page - 1) * pageSize + 1;
const heading = q ? `Hasil untuk “${q}”` : current ? current.name : "Semua produk";
const pastEnd = !error && !invalid && products.length === 0 && page > 1;
if (pastEnd) Astro.response.status = 404;
// Page size is a display preference, so every size shares the default-size canonical page.
const canonicalParams = new URLSearchParams();
if (category) canonicalParams.set("category", category);
if (page > 1) canonicalParams.set("page", String(page));
const canonical = category ? `/catalog?${canonicalParams}` : `${Astro.url.pathname}${canonicalParams.size ? `?${canonicalParams}` : ""}`;
const monthDay = new Intl.DateTimeFormat("id-ID", { day: "numeric", month: "short", timeZone: "Asia/Jakarta" });
const shipWindow = (from: string | number, to: string | number) => `${monthDay.format(new Date(from))} – ${monthDay.format(new Date(to))}`;
type Badge = { label: string; tone: "stock" | "low" | "out" | "preorder" };
// Exact counts are never public; badges summarise variant stock levels and the earliest pre-order window.
function summary(p: Product) {
  const stock = p.variants.filter((v) => v.mode === "stock");
  const preorder = p.variants.filter((v) => v.mode === "preorder");
  const badges: Badge[] = [];
  if (stock.some((v) => v.stockLevel === "in_stock")) badges.push({ label: "Ready stock", tone: "stock" });
  else if (stock.some((v) => v.stockLevel === "low")) badges.push({ label: "Stok terbatas", tone: "low" });
  const campaign = preorder.map((v) => v.campaign).filter((c) => !!c).sort((a, b) => new Date(a!.shipFrom).getTime() - new Date(b!.shipFrom).getTime())[0];
  if (preorder.length) badges.push({ label: "Pre-order", tone: "preorder" });
  const soldOut = !p.variants.length || p.variants.every((v) => v.stockLevel === "out");
  if (soldOut) badges.splice(0, badges.length, { label: "Habis", tone: "out" });
  const prices = p.variants.map((v) => v.price);
  return {
    badges,
    soldOut,
    ship: !soldOut && campaign ? `Kirim ${shipWindow(campaign.shipFrom, campaign.shipTo)}` : "",
    price: prices.length ? `${new Set(prices).size > 1 ? "Mulai " : ""}${money(Math.min(...prices))}` : "Belum tersedia",
  };
}
---

<Layout title={current ? `${current.name} — Flaremmerce` : q ? `Cari “${q}” — Flaremmerce` : "Board game untuk main bareng — Flaremmerce"} canonical={canonical} noindex={!!q || !!invalid}>
  <section class="section catalog">
    <div class="catalog-intro">
      <div>
        <p class="eyebrow">Board games · Waktunya kumpul</p>
        <h1>Buka kotaknya.<br /><span>Mulai serunya.</span></h1>
      </div>
      <div class="catalog-invitation">
        <svg class="dice" viewBox="0 0 120 80" aria-hidden="true" fill="none">
          <g transform="rotate(-12 36 42)">
            <rect x="10" y="16" width="52" height="52" rx="8" stroke="currentColor" stroke-width="3" />
            <g fill="currentColor"><circle cx="24" cy="30" r="4" /><circle cx="48" cy="30" r="4" /><circle cx="36" cy="42" r="4" /><circle cx="24" cy="54" r="4" /><circle cx="48" cy="54" r="4" /></g>
          </g>
          <g transform="rotate(12 88 34)">
            <rect x="66" y="12" width="44" height="44" rx="7" fill="currentColor" />
            <g fill="var(--blue)"><circle cx="78" cy="24" r="3.5" /><circle cx="88" cy="34" r="3.5" /><circle cx="98" cy="44" r="3.5" /></g>
          </g>
        </svg>
        <p>Kumpulkan teman. Siapkan meja.<br />Satu ronde lagi? Selalu.</p>
      </div>
    </div>
    <div class="catalog-filters">
      <form class="catalog-search" method="get" action={Astro.url.pathname} role="search">
        <label class="sr-only" for="catalog-q">Cari produk</label>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4.5 4.5" /></svg>
        <input id="catalog-q" name="q" type="search" minlength="2" maxlength="60" placeholder="Cari nama board game" value={q ?? rawQ.slice(0, 60)} aria-describedby="catalog-q-help" />
        {category && <input type="hidden" name="category" value={category} />}
        {pageSize !== DEFAULT_PAGE_SIZE && <input type="hidden" name="limit" value={pageSize} />}
        <button type="submit">Cari</button>
      </form>
      <p id="catalog-q-help" class="sr-only">Minimal 2 karakter.</p>
      {categories.length > 0 && (
        <nav class="chips" aria-label="Kategori">
          <a class="chip" href={link({ q })} aria-current={!category ? "page" : undefined}>Semua</a>
          {categories.map((c) => (
            <a class="chip" href={link({ category: c.slug, q })} aria-current={c.slug === category ? "page" : undefined}>{c.name}</a>
          ))}
        </nav>
      )}
    </div>
    <div class="catalog-toolbar">
      <h2>{heading}</h2>
      {!error && !invalid && products.length > 0 && (
        <span class="muted">{pages > 1 ? `${firstShown}–${firstShown + products.length - 1} dari ${total} produk` : `${total} produk`}</span>
      )}
      {q && <a class="muted clear-search" href={link({ category })}>Hapus pencarian</a>}
    </div>
    {invalid ? (
      <div class="notice" role="alert">
        {invalid} <a href={Astro.url.pathname}>Lihat semua produk</a>
      </div>
    ) : error ? (
      <div class="notice error" role="alert">
        {error} <a href={Astro.url.pathname + Astro.url.search}>Muat ulang</a>
      </div>
    ) : products.length === 0 ? (
      <div class="empty-state">
        <svg viewBox="0 0 48 48" aria-hidden="true"><rect x="8" y="8" width="32" height="32" rx="5" /><circle cx="18" cy="18" r="2.5" /><circle cx="30" cy="30" r="2.5" /></svg>
        {pastEnd ? (
          <>
            <h3>Halaman ini tidak ada</h3>
            <p>{total ? `Katalog ini hanya sampai halaman ${pages}.` : "Tidak ada produk di daftar ini."}</p>
            <a class="button" href={pageLink(1)}>Ke halaman pertama</a>
          </>
        ) : q || category ? (
          <>
            <h3>Tidak ada produk yang cocok</h3>
            <p>Coba kata kunci lain atau pilih kategori berbeda.</p>
            <a class="button" href={Astro.url.pathname}>Lihat semua produk</a>
          </>
        ) : (
          <>
            <h3>Koleksi baru sedang disiapkan</h3>
            <p>Kembali lagi nanti untuk melihat board game terbaru.</p>
          </>
        )}
      </div>
    ) : (
      <ul class="grid" role="list">
        {products.map((p) => {
          const s = summary(p);
          return (
            <li>
              <a class:list={["card", { "sold-out": s.soldOut }]} href={"/products/" + encodeURIComponent(p.slug)}>
                <div class="art">
                  {p.imageUrl && <img src={p.imageUrl} alt="" loading="lazy" />}
                  <div class="availability">
                    {s.badges.map((b) => <span class={`badge ${b.tone}`}>{b.label}</span>)}
                  </div>
                </div>
                <div class="card-body">
                  {p.category && <span class="card-category">{p.category.name}</span>}
                  <h3>{p.name}</h3>
                  <span class="card-price">{s.price}</span>
                  {s.ship && <span class="card-ship">{s.ship}</span>}
                  {p.variants.length > 1 && <span class="variant-count">{p.variants.length} varian</span>}
                </div>
              </a>
            </li>
          );
        })}
      </ul>
    )}
    {!error && !invalid && products.length > 0 && (pages > 1 || total > PAGE_SIZES[0]) && (
      <nav class="pager" aria-label="Halaman katalog">
        <div class="page-size">
          <span class="muted">Tampilkan</span>
          {PAGE_SIZES.map((size) => (
            <a class="chip" href={pageLink(1, size)} rel="nofollow" aria-current={size === pageSize ? "true" : undefined} aria-label={`${size} produk per halaman`}>{size}</a>
          ))}
          <span class="muted">per halaman</span>
        </div>
        {pages > 1 && (
          <ol class="pages" role="list">
            <li>
              {page > 1 ? <a class="button secondary" href={pageLink(page - 1)} rel="prev" aria-label="Halaman sebelumnya">← <span>Sebelumnya</span></a> : <span class="button secondary" aria-disabled="true">← <span>Sebelumnya</span></span>}
            </li>
            {pageWindow(page, pages).map((n) => (
              <li class="page-number">
                {n === null ? <span aria-hidden="true">…</span> : <a href={pageLink(n)} aria-current={n === page ? "page" : undefined} aria-label={`Halaman ${n}`}>{n}</a>}
              </li>
            ))}
            <li>
              {page < pages ? <a class="button secondary" href={pageLink(page + 1)} rel="next" aria-label="Halaman berikutnya"><span>Berikutnya</span> →</a> : <span class="button secondary" aria-disabled="true"><span>Berikutnya</span> →</span>}
            </li>
          </ol>
        )}
      </nav>
    )}
    <div class="shopping-guide">
      <div><h2>Ready stock</h2><p>Pilih varian dan lihat ketersediaannya di halaman produk.</p></div>
      <div><h2>Pre-order</h2><p>Periode pemesanan dan estimasi kirim tertera pada produk.</p></div>
      <a href="/policies">Panduan belanja <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</Layout>
