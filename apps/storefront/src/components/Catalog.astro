---
import Layout from "../layouts/Layout.astro";
import { catalog, money, type Product } from "../lib/catalog";
import { catalogParams, searchTerm } from "../../../../src/shared";
type Category = { id: string; slug: string; name: string };
let products: Product[] = [];
let categories: Category[] = [];
let error = "";
let invalid = "";
let nextCursor: string | null = null;
const rawQ = Astro.url.searchParams.get("q") ?? "";
const q = searchTerm(rawQ);
const rawCategory = Astro.url.searchParams.get("category") ?? "";
const category = rawCategory && catalogParams.category(rawCategory) ? rawCategory : "";
if (q === null) invalid = "Kata kunci pencarian harus 2–60 karakter.";
else if (rawCategory && !category) invalid = "Kategori tidak dikenal.";
try {
  categories = (await catalog(Astro.locals, "/api/categories")).categories;
  if (!invalid) {
    const query = new URLSearchParams();
    for (const name of ["after", "limit"]) {
      const value = Astro.url.searchParams.get(name);
      if (value !== null) query.set(name, value);
    }
    if (category) query.set("category", category);
    if (q) query.set("q", q);
    const page = await catalog(Astro.locals, `/api/catalog?${query}`);
    products = page.products;
    nextCursor = page.nextCursor;
  }
} catch {
  error =
    "Katalog sementara tidak tersedia. Silakan muat ulang beberapa saat lagi.";
  Astro.response.status = 503;
}
if (invalid) Astro.response.status = 400;
Astro.response.headers.set(
  "Cache-Control",
  error || invalid ? "no-store" : "public, max-age=0, s-maxage=60",
);
const current = categories.find((c) => c.slug === category);
const link = (next: { category?: string; q?: string | null }) => {
  const params = new URLSearchParams();
  if (next.category) params.set("category", next.category);
  if (next.q) params.set("q", next.q);
  return `${Astro.url.pathname}${params.size ? `?${params}` : ""}`;
};
const nextQuery = new URLSearchParams();
if (nextCursor) nextQuery.set("after", nextCursor);
const limit = Astro.url.searchParams.get("limit");
if (limit !== null) nextQuery.set("limit", limit);
if (category) nextQuery.set("category", category);
if (q) nextQuery.set("q", q);
const heading = q ? `Hasil untuk “${q}”` : current ? current.name : "Semua produk";
---

<Layout title={current ? `${current.name} — Flaremmerce` : q ? `Cari “${q}” — Flaremmerce` : "Board game untuk main bareng — Flaremmerce"} canonical={category ? `/catalog?category=${encodeURIComponent(category)}` : Astro.url.pathname} noindex={!!q || !!invalid}>
  <section class="section catalog">
    <div class="catalog-intro">
      <div>
        <p class="eyebrow">Board games · Waktunya kumpul</p>
        <h1>Buka kotaknya.<br /><span>Mulai serunya.</span></h1>
      </div>
      <div class="catalog-invitation">
        <svg class="dice" viewBox="0 0 120 80" aria-hidden="true" fill="none">
          <g transform="rotate(-12 36 42)">
            <rect x="10" y="16" width="52" height="52" rx="8" stroke="currentColor" stroke-width="3" />
            <g fill="currentColor"><circle cx="24" cy="30" r="4" /><circle cx="48" cy="30" r="4" /><circle cx="36" cy="42" r="4" /><circle cx="24" cy="54" r="4" /><circle cx="48" cy="54" r="4" /></g>
          </g>
          <g transform="rotate(12 88 34)">
            <rect x="66" y="12" width="44" height="44" rx="7" fill="currentColor" />
            <g fill="var(--blue)"><circle cx="78" cy="24" r="3.5" /><circle cx="88" cy="34" r="3.5" /><circle cx="98" cy="44" r="3.5" /></g>
          </g>
        </svg>
        <p>Kumpulkan teman. Siapkan meja.<br />Satu ronde lagi? Selalu.</p>
      </div>
    </div>
    <div class="catalog-filters">
      <form class="catalog-search" method="get" action={Astro.url.pathname} role="search">
        <label class="sr-only" for="catalog-q">Cari produk</label>
        <input id="catalog-q" name="q" type="search" minlength="2" maxlength="60" placeholder="Cari nama produk" value={q ?? rawQ.slice(0, 60)} />
        {category && <input type="hidden" name="category" value={category} />}
        <button type="submit">Cari</button>
      </form>
      {categories.length > 0 && (
        <nav class="chips" aria-label="Kategori">
          <a class="chip" href={link({ q })} aria-current={!category ? "page" : undefined}>Semua</a>
          {categories.map((c) => (
            <a class="chip" href={link({ category: c.slug, q })} aria-current={c.slug === category ? "page" : undefined}>{c.name}</a>
          ))}
        </nav>
      )}
    </div>
    <div class="catalog-toolbar">
      <h2>{heading}</h2>
      {!error && <span class="muted">{products.length} produk di halaman ini</span>}
    </div>
    {invalid ? (
      <div class="notice" role="alert">
        {invalid} <a href={Astro.url.pathname}>Lihat semua produk</a>
      </div>
    ) : error ? (
      <div class="notice error" role="alert">
        {error} <a href={Astro.url.pathname + Astro.url.search}>Muat ulang</a>
      </div>
    ) : products.length === 0 ? (
      <div class="notice">
        {q || category ? <>Tidak ada produk yang cocok. <a href={Astro.url.pathname}>Lihat semua produk</a></> : "Koleksi baru sedang disiapkan. Kembali lagi nanti."}
      </div>
    ) : (
      <div class="grid">
        {products.map((p) => (
          <a class="card" href={"/products/" + encodeURIComponent(p.slug)}>
            <div class="art">
              {p.imageUrl && (
                <img src={p.imageUrl} alt={p.name} loading="lazy" />
              )}
              <div class="availability">
                {p.variants.some((v) => v.mode === "stock" && v.stockLevel !== "out") && <span class="badge stock">Ready stock</span>}
                {p.variants.some((v) => v.mode === "preorder") && <span class="badge preorder">Pre-order</span>}
                {p.variants.some((v) => v.mode === "stock" && v.stockLevel === "low") && !p.variants.some((v) => v.mode === "stock" && v.stockLevel === "in_stock") && <span class="badge">Stok terbatas</span>}
                {!p.variants.some((v) => v.mode === "preorder" || v.stockLevel !== "out") && <span class="badge">Habis</span>}
              </div>
            </div>
            <div class="product-heading">
              <h3>{p.name}</h3>
              <span>
                {p.variants.length > 1 && "Mulai "}
                {p.variants.length
                  ? money(Math.min(...p.variants.map((v) => v.price)))
                  : "Belum tersedia"}
              </span>
            </div>
            <p class="product-description">{p.description}</p>
            <span class="variant-count">{p.variants.length} varian <span aria-hidden="true">↗</span></span>
          </a>
        ))}
      </div>
    )}
    {nextCursor && <a class="button pagination" href={`${Astro.url.pathname}?${nextQuery}`}>Produk berikutnya →</a>}
    <div class="shopping-guide">
      <div><h2>Ready stock</h2><p>Pilih varian dan lihat ketersediaannya di halaman produk.</p></div>
      <div><h2>Pre-order</h2><p>Periode pemesanan dan estimasi kirim tertera pada produk.</p></div>
      <a href="/policies">Panduan belanja <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</Layout>
