---
import Layout from "../layouts/Layout.astro";
import { catalog, money, type Product } from "../lib/catalog";
let products: Product[] = [];
let error = "";
try {
  products = (await catalog(Astro.locals)).products;
} catch {
  error =
    "Katalog sementara tidak tersedia. Silakan muat ulang beberapa saat lagi.";
  Astro.response.status = 503;
}
Astro.response.headers.set(
  "Cache-Control",
  error ? "no-store" : "public, max-age=0, s-maxage=60",
);
---

<Layout title="Koleksi — Flaremmerce">
  <section class="section">
    <p class="eyebrow">Pilihan untuk keseharian</p>
    <div class="row">
      <h1>Koleksi kami.</h1>
      <span class="muted">{products.length} produk</span>
    </div>
    <p>Temukan sesuatu yang terasa seperti kamu.</p>
    {error ? (
      <div class="notice error" role="alert">
        {error} <a href="/catalog">Muat ulang</a>
      </div>
    ) : products.length === 0 ? (
      <div class="notice">
        Koleksi baru sedang disiapkan. Kembali lagi nanti.
      </div>
    ) : (
      <div class="grid">
        {products.map((p) => (
          <a class="card" href={"/products/" + encodeURIComponent(p.slug)}>
            <div class="art">
              {p.imageUrl && (
                <img src={p.imageUrl} alt={p.name} loading="lazy" />
              )}
            </div>
            <span class="badge">
              {p.variants.some((v) => v.mode === "preorder")
                ? "Pre-order tersedia"
                : "Ready stock"}
            </span>
            <h3>{p.name}</h3>
            <div class="row">
              <span>
                {p.variants.length
                  ? money(Math.min(...p.variants.map((v) => v.price)))
                  : "Belum tersedia"}
              </span>
              <span>↗</span>
            </div>
          </a>
        ))}
      </div>
    )}
  </section>
</Layout>
