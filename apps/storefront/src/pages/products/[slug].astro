---
import Layout from "../../layouts/Layout.astro";
import ProductPicker from "../../components/ProductPicker";
import { catalog, type Product } from "../../lib/catalog";
let product: Product | undefined;
let failed = false;
try {
  product = (
    await catalog(
      Astro.locals,
      "/api/catalog/" + encodeURIComponent(Astro.params.slug!),
    )
  ).product;
} catch {
  failed = true;
}
if (!product) Astro.response.status = failed ? 503 : 404;
Astro.response.headers.set(
  "Cache-Control",
  product ? "public, max-age=0, s-maxage=60" : "no-store",
);
const canonical = product && `/products/${encodeURIComponent(product.slug)}`;
const availability = (v: Product["variants"][number]) => v.mode === "preorder" ? "https://schema.org/PreOrder" : v.stockLevel === "out" ? "https://schema.org/OutOfStock" : v.stockLevel === "low" ? "https://schema.org/LimitedAvailability" : "https://schema.org/InStock";
const jsonLd = product && {
  "@context": "https://schema.org",
  "@type": "Product",
  name: product.name,
  description: product.description.slice(0, 5000),
  ...(product.imageUrl ? { image: [product.imageUrl] } : {}),
  ...(product.category ? { category: product.category.name } : {}),
  offers: product.variants.map((v) => ({
    "@type": "Offer",
    sku: v.sku,
    name: v.name,
    price: String(v.price),
    priceCurrency: "IDR",
    availability: availability(v),
    url: new URL(canonical!, Astro.url.origin).href,
  })),
};
---

<Layout
  title={(product?.name || "Produk tidak tersedia") + " — Flaremmerce"}
  description={product?.description || undefined}
  canonical={canonical || undefined}
  image={product?.imageUrl}
  type={product ? "product" : "website"}
  jsonLd={jsonLd || undefined}
  noindex={!product}
>
  <section class="section">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Beranda</a></li>
        {product?.category ? (
          <li><a href={`/catalog?category=${encodeURIComponent(product.category.slug)}`}>{product.category.name}</a></li>
        ) : (
          <li><a href="/catalog">Katalog</a></li>
        )}
        <li aria-current="page">{product?.name || "Produk"}</li>
      </ol>
    </nav>
    {product ? (
      <div class="detail">
        <div class="art">
          {product.imageUrl && (
            <img src={product.imageUrl} alt={product.name} />
          )}
        </div>
        <div class="detail-info">
          {product.category && <p class="eyebrow">{product.category.name}</p>}
          <h1>{product.name}</h1>
          <ProductPicker product={product} client:load />
          {product.description && (
            <div class="detail-description">
              <h2>Tentang produk</h2>
              <p>{product.description}</p>
            </div>
          )}
        </div>
      </div>
    ) : (
      <div class="empty-state" role="alert">
        <h3>{failed ? "Katalog sementara tidak tersedia" : "Produk tidak ditemukan"}</h3>
        <p>{failed ? "Silakan muat ulang beberapa saat lagi." : "Produk ini mungkin sudah tidak dijual."}</p>
        <a class="button" href="/catalog">Kembali ke katalog</a>
      </div>
    )}
  </section>
</Layout>
