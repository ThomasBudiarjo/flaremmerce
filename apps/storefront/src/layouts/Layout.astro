---
import "../styles/site.css";
const {
  title = "Flaremmerce — Katalog produk",
  description = "Koleksi pilihan Flaremmerce. Ready stock dan pre-order dengan estimasi pengiriman yang jelas.",
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="referrer" content="no-referrer" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main">
      Lewati ke konten
    </a>
    <header>
      <a class="brand" href="/">
        flare<span>mmerce</span>
      </a>
      <nav aria-label="Navigasi utama">
        <a href="/" aria-current={Astro.url.pathname === '/' || Astro.url.pathname === '/catalog' ? 'page' : undefined}>Katalog</a>
        <a href="/order">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 8 4v10l-8 4-8-4V7l8-4Z M4 7l8 4 8-4 M12 11v10 M8 5l8 4" /></svg>
          Pesanan
        </a>
        <a class="cartlink" href="/cart">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2l3 12h11l2-9H6 M9 20h.01 M18 20h.01" /></svg>
          Keranjang
        </a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <a class="brand" href="/">
        flaremmerce
      </a>
      <p>Ready stock & pre-order · Pengiriman Indonesia</p>
      <a href="/policies">Pengiriman & informasi belanja</a>
      <small>© {new Date().getFullYear()} Flaremmerce · Indonesia</small>
    </footer>
  </body>
</html>
