---
import "../styles/site.css";
interface Props {
  title?: string;
  description?: string;
  /** Path plus allowlisted query of the canonical URL; defaults to the bare path. */
  canonical?: string;
  image?: string | null;
  type?: "website" | "product";
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}
const {
  title = "Flaremmerce — Toko board game",
  description = "Temukan board game untuk sesi main berikutnya di Flaremmerce. Ready stock dan pre-order dengan estimasi pengiriman yang jelas.",
  canonical,
  image,
  type = "website",
  jsonLd,
  noindex = false,
} = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
// Prerendered pages are built without the real host, so their canonical stays path-relative.
const canonicalUrl = Astro.isPrerendered ? (canonical ?? pathname) : new URL(canonical ?? pathname, Astro.url.origin).href;
const summary = description.length > 160 ? `${description.slice(0, 157).trimEnd()}…` : description;
// JSON-LD is data, not script: `<` is escaped so product text can never close the element.
const structured = jsonLd && JSON.stringify(jsonLd).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={summary} />
    <meta name="referrer" content="no-referrer" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content="Flaremmerce" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={summary} />
    <meta property="og:url" content={canonicalUrl} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    {structured && <script type="application/ld+json" is:inline set:html={structured} />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main">
      Lewati ke konten
    </a>
    <div class="store-note">Ready stock & pre-order <span aria-hidden="true">·</span> Pengiriman Indonesia</div>
    <header>
      <a class="brand" href="/" aria-label="Flaremmerce — beranda">flaremmerce</a>
      <nav aria-label="Navigasi utama">
        <a href="/catalog" aria-current={pathname === '/' || pathname === '/catalog' || pathname.startsWith('/products/') ? 'page' : undefined}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h7v7H4z M13 4h7v7h-7z M4 13h7v7H4z M13 13h7v7h-7z" /></svg>
          Katalog
        </a>
        <a class="shopping-info" href="/policies" aria-current={pathname === '/policies' ? 'page' : undefined}>Informasi belanja</a>
        <a href="/order" aria-current={pathname === '/order' ? 'page' : undefined}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 8 4v10l-8 4-8-4V7l8-4Z M4 7l8 4 8-4 M12 11v10 M8 5l8 4" /></svg>
          Pesanan saya
        </a>
        <a class="cartlink" href="/cart" aria-current={pathname === '/cart' ? 'page' : undefined}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 7h14l1 14H4L5 7Z M9 8V6a3 3 0 0 1 6 0v2" /></svg>
          Keranjang
          <span class="cart-count" data-cart-count hidden></span>
        </a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <div class="footer-main">
        <div>
          <a class="brand" href="/">flaremmerce</a>
          <p>Board game. Teman main. Satu ronde lagi.</p>
        </div>
        <div class="footer-links">
          <h2>Belanja</h2>
          <a href="/catalog">Katalog</a>
          <a href="/cart">Keranjang</a>
          <a href="/order">Pesanan saya</a>
        </div>
        <div class="footer-links">
          <h2>Bantuan</h2>
          <a href="/policies">Pengiriman & pembayaran</a>
          <a href="/returns">Komplain & retur</a>
          <a href="/about">Tentang & kontak</a>
        </div>
        <nav class="footer-links" aria-label="Legal">
          <h2>Legal</h2>
          <a href="/privacy">Kebijakan privasi</a>
          <a href="/terms">Syarat & ketentuan</a>
        </nav>
      </div>
      <div class="footer-bottom">
        <small>© {new Date().getFullYear()} Flaremmerce</small>
        <small>Indonesia · IDR</small>
      </div>
    </footer>
  </body>
</html>
