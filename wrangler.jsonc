{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flaremmerce-local",
  "main": "src/entry.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "apps/storefront/dist/client",
    "binding": "ASSETS",
    // Cart/order are prerendered public shells; private data stays in no-store APIs.
    // Static CSP hashes are generated by scripts/assets.mjs, without runtime HTML scanning.
    "run_worker_first": ["/", "/api/*", "/admin", "/admin/*", "!/admin/assets/*", "/catalog", "/products/*", "/sitemap.xml", "/robots.txt", "/media/*"]
  },
  "d1_databases": [{"binding":"DB", "database_name":"flaremmerce-local", "database_id":"00000000-0000-0000-0000-000000000001", "migrations_dir":"migrations"}],
  "r2_buckets": [{"binding":"MEDIA","bucket_name":"flaremmerce-local-media"},{"binding":"PRIVATE_FILES","bucket_name":"flaremmerce-local-private"}],
  "queues": {"producers":[{"binding":"JOBS","queue":"flaremmerce-local-jobs"}],"consumers":[{"queue":"flaremmerce-local-jobs","max_batch_size":10,"max_batch_timeout":5,"max_retries":3}]},
  // Limits are per Cloudflare location and must mirror RATE_LIMITS in src/ratelimit.ts (the D1 fallback).
  "ratelimits": [
    {"name":"RL_CHECKOUT", "namespace_id":"1001", "simple":{"limit":10, "period":60}},
    {"name":"RL_QUOTE", "namespace_id":"1002", "simple":{"limit":30, "period":60}},
    {"name":"RL_LOOKUP", "namespace_id":"1003", "simple":{"limit":60, "period":60}},
    {"name":"RL_AUTH", "namespace_id":"1004", "simple":{"limit":10, "period":60}}
  ],
  "vars": {"PUBLIC_ORIGIN":"http://localhost:8787", "DOKU_MODE":"sandbox"},
  "triggers": {"crons":["*/5 * * * *"]},
  "observability": {"enabled":true},
  // Selected at build time with CLOUDFLARE_ENV=staging (npm run build:staging); bindings, vars and triggers are not inherited.
  "env": {
    "staging": {
      "name": "flaremmerce-staging",
      "workers_dev": true,
      "d1_databases": [{"binding":"DB", "database_name":"flaremmerce-staging", "database_id":"1b43ef8b-4562-480f-8a64-cb5a030c862d", "migrations_dir":"migrations"}],
      "r2_buckets": [{"binding":"MEDIA","bucket_name":"flaremmerce-staging-media"},{"binding":"PRIVATE_FILES","bucket_name":"flaremmerce-staging-private"}],
      "queues": {"producers":[{"binding":"JOBS","queue":"flaremmerce-staging-jobs"}],"consumers":[{"queue":"flaremmerce-staging-jobs","max_batch_size":10,"max_batch_timeout":5,"max_retries":3,"dead_letter_queue":"flaremmerce-staging-jobs-dlq"}]},
      "ratelimits": [
        {"name":"RL_CHECKOUT", "namespace_id":"2001", "simple":{"limit":10, "period":60}},
        {"name":"RL_QUOTE", "namespace_id":"2002", "simple":{"limit":30, "period":60}},
        {"name":"RL_LOOKUP", "namespace_id":"2003", "simple":{"limit":60, "period":60}},
        {"name":"RL_AUTH", "namespace_id":"2004", "simple":{"limit":10, "period":60}}
      ],
      // Media is served by this Worker at /media/* (MEDIA_ORIGIN = PUBLIC_ORIGIN): *.r2.dev is DNS-blocked by Indonesian ISPs. Production uses an R2 custom domain.
      "vars": {"APP_ENV":"staging", "PUBLIC_ORIGIN":"https://flaremmerce-staging.thomasbudiarjo.workers.dev", "DOKU_MODE":"sandbox", "MEDIA_ORIGIN":"https://flaremmerce-staging.thomasbudiarjo.workers.dev"},
      "triggers": {"crons":["*/5 * * * *"]},
      "observability": {"enabled":true}
    }
  }
}
